<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.spring.product.model.dao.ProductSaveMapper">

	<insert id="save"
			parameterType="com.kh.spring.product.model.dto.ProductSaveDTO">
		INSERT
		  INTO
		       TB_PRODUCT
		VALUES
		       (
		       SEQ_PNO.NEXTVAL
		     , #{productName}
		     , #{price}
		     , #{categoryNo}
		     , #{memberNo}
		     , #{detailContent}
		     , #{fileOriginName}
		     , #{changeName}
		       )
	</insert>

</mapper>